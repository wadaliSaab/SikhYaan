model DoubtCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doubts Doubt[]

  @@index([isActive, name])
}

model Doubt {
  id                      String   @id @default(uuid())
  title                   String
  body                    String
  categoryId              String
  authorId                String
  referencedContentItemId String?
  isActive                Boolean  @default(true)
  isResolved              Boolean  @default(false)
  isPinned                Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  author            User          @relation(fields: [authorId], references: [id])
  category          DoubtCategory @relation(fields: [categoryId], references: [id])
  referencedContent ContentItem?  @relation("DoubtReferencedContent", fields: [referencedContentItemId], references: [id], onDelete: SetNull)

  images        DoubtImage[]
  likes         DoubtLike[]
  bookmarks     DoubtBookmark[]
  notifications Notification[]
  replies       Reply[]

  @@index([categoryId, createdAt])
  @@index([authorId, createdAt])
  @@index([isActive, isPinned, createdAt])
  @@index([isActive, isResolved, createdAt])
  @@index([referencedContentItemId])
}

model Reply {
  id            String   @id @default(uuid())
  doubtId       String
  authorId      String
  body          String
  parentReplyId String?
  replyToId     String?
  isPinned      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author User  @relation(fields: [authorId], references: [id])
  doubt  Doubt @relation(fields: [doubtId], references: [id], onDelete: Cascade)

  parentReply  Reply?  @relation("ReplyThread", fields: [parentReplyId], references: [id], onDelete: Cascade)
  childReplies Reply[] @relation("ReplyThread")

  replyTo         Reply?  @relation("ReplyTarget", fields: [replyToId], references: [id], onDelete: SetNull)
  targetedReplies Reply[] @relation("ReplyTarget")

  likes ReplyLike[]

  @@index([doubtId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentReplyId, createdAt])
  @@index([replyToId])
  @@index([doubtId, isPinned, createdAt])
  notifications Notification[]
}

model DoubtLike {
  userId    String
  doubtId   String
  createdAt DateTime @default(now())

  doubt Doubt @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, doubtId])
  @@index([doubtId, createdAt])
}

model DoubtBookmark {
  userId    String
  doubtId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  doubt Doubt @relation(fields: [doubtId], references: [id], onDelete: Cascade)

  @@id([userId, doubtId])
  @@index([userId, createdAt])
  @@index([doubtId])
}

model ReplyLike {
  userId    String
  replyId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply Reply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@id([userId, replyId])
  @@index([replyId, createdAt])
}

model DoubtImage {
  id        String   @id @default(uuid())
  doubtId   String
  mediaId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  doubt Doubt @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id])

  @@index([doubtId, sortOrder])
}

