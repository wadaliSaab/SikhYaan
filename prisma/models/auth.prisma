model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  avatarMediaId String?        @unique
  roleId        String
  isOfficial    Boolean        @default(false)
  doubts        Doubt[]
  doubtLikes    DoubtLike[]
  notifications Notification[]

  doubtBookmarks DoubtBookmark[]
  replyLikes     ReplyLike[]
  deletedAt DateTime?

  replies          Reply[]
  avatar           Media?          @relation("UserAvatar", fields: [avatarMediaId], references: [id])
  reviewedRequests RoleRequest[]   @relation("ReviewedRoleRequests")
  roleRequests     RoleRequest[]   @relation("UserRoleRequests")
  sessions         Session[]
  role             Role            @relation(fields: [roleId], references: [id])
  gyaanTests       GyaanTest[]     @relation("GyaanTestCreator")
  gyaanQuestions   GyaanQuestion[] @relation("GyaanQuestionCreator")
  gyaanAttempts    GyaanAttempt[]  @relation("GyaanAttemptUser")
  notificationReads NotificationRead[]
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?
  user             User      @relation(fields: [userId], references: [id])
}

model Role {
  id           String        @id @default(uuid())
  name         String        @unique
  description  String?
  createdAt    DateTime      @default(now())
  roleRequests RoleRequest[] @relation("RequestedRole")
  users        User[]
}
